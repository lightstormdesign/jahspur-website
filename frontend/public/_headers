# Cloudflare static assets: the world media and build files never change at
# a given URL (world media is cache-busted with ?v=MEDIA_V, build files are
# content-hashed), so browsers can keep them for a year. HTML keeps the
# default (revalidated every visit), so a deploy shows up right away.
/world/*
  Cache-Control: public, max-age=31536000, immutable
/static/*
  Cache-Control: public, max-age=31536000, immutable
