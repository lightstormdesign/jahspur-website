{
  "name": "jahspur-website",
  "compatibility_date": "2026-08-01",
  // Runs before every `wrangler deploy` (including Cloudflare's own build
  // pipeline), so frontend/build always exists when assets are uploaded.
  "build": {
    "command": "cd frontend && yarn install --frozen-lockfile && yarn build"
  },
  "assets": {
    "directory": "./frontend/build",
    // React Router: serve index.html for /about, /album, etc. so direct
    // links and page refreshes don't 404.
    "not_found_handling": "single-page-application"
  }
}
