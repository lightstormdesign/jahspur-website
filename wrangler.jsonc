{
  "name": "jahspur-website",
  "compatibility_date": "2026-08-01",
  // Runs before every `wrangler deploy` (including Cloudflare's own build
  // pipeline), so frontend/build always exists when assets are uploaded.
  // Yarn is pinned to 1.x: Cloudflare's image ships Yarn 4, which rejects
  // this project's Yarn 1 lockfile.
  "build": {
    "command": "cd frontend && npx --yes yarn@1.22.22 install --frozen-lockfile --non-interactive && npx --yes yarn@1.22.22 build"
  },
  "assets": {
    "directory": "./frontend/build",
    // React Router: serve index.html for /about, /album, etc. so direct
    // links and page refreshes don't 404.
    "not_found_handling": "single-page-application"
  }
}
